# CHAIR web app: server environment. Copy to .env.local (gitignored) and fill in.
# Everything but the secrets has a testnet default; the read-only routes
# (state, meetings, petitions, sim, forge and garbage previews) need nothing.

# Network and contract. token5 is the testnet token whose chair is NEAR AI's
# model, reached through this site's relay; the relayed petitions, convene and
# the playground all target this contract. The landing also reads token3, the
# test chair, by name. Mainnet: CHAIR_NETWORK=mainnet, CHAIR_CONTRACT_ID=token.thechair.near
CHAIR_NETWORK=testnet
CHAIR_CONTRACT_ID=token5.chair-dev.testnet

# RPC (defaults: FastNEAR for the network; rpc.testnet.near.org rate-limits).
# CHAIR_RPC_URL=https://test.rpc.fastnear.com
# CHAIR_ARCHIVAL_RPC_URL=https://archival-rpc.testnet.fastnear.com

# NearBlocks API v3, used to find each meeting's convene transaction.
# NEARBLOCKS_API_URL=https://api-testnet.nearblocks.io
# NEARBLOCKS_API_KEY=

# Optional: pin known convene transactions of CHAIR_CONTRACT_ID, meeting:hash
# pairs. token5's, token3's and mainnet's launch meetings are built in (docs/LAUNCH.md).
# CHAIR_KNOWN_CONVENES=1:<tx hash>,2:<tx hash>

# The mainnet token the landing reads, read-only, whatever CHAIR_NETWORK is
# (its "Live on mainnet" strip). Defaults shown; the RPC must serve mainnet.
# CHAIR_MAINNET_CONTRACT_ID=token.thechair.near
# CHAIR_MAINNET_RPC_URL=https://rpc.mainnet.fastnear.com

# Secret. Testnet only: the test model signer key (32-byte secp256k1 hex),
# address 0xc053…a87f, on token5's (and token3's) model_signers for exactly
# this. Signs the playground's jailbreak and signed-garbage previews. Mainnet's
# allowlist holds only NEAR AI keys.
CHAIR_TEST_MODEL_KEY=

# Secret. The demo account that pays for relayed petitions and convenes.
# Never use the token owner's key here. A convene on token5 asks NEAR AI's
# model through the relay below and lands in about a minute; POST /api/convene
# waits up to 150 s (maxDuration 180).
CHAIR_DEMO_ACCOUNT_ID=
CHAIR_DEMO_SECRET_KEY=

# Relay and convene limits (defaults shown).
# CHAIR_RELAY_POOL_SIZE=8
# CHAIR_RELAY_BUY_NEAR=0.06
# CHAIR_RELAY_LOCK_DAYS=1
# CHAIR_RELAY_FLOOR_NEAR=2
# CHAIR_RELAY_DAILY_CAP_NEAR=1.5
# CHAIR_RELAY_IP_COOLDOWN_S=600
# CHAIR_RELAY_IP_DAILY_MAX=5
# CHAIR_CONVENE_IP_COOLDOWN_S=120

# Secret. The NEAR AI Cloud API key for the courier's NEAR AI relay
# (/api/nearai/v1/chat/completions and /api/nearai/v1/signature/[chatId]).
# Unset: the relay answers 503 and forwards nothing. See docs/SECURITY.md, "Relay".
NEARAI_API_KEY=

# Token contracts whose courier may use the relay, comma-separated; each one's
# network (and RPC) follows its .testnet / .near suffix. Default: the site's
# network token (token5.chair-dev.testnet on testnet, token.thechair.near on
# mainnet). One deployment serving both:
# CHAIR_RELAY_TOKENS=token5.chair-dev.testnet,token.thechair.near
# Upstream completions per (token, meeting) per server instance (default 2).
# CHAIR_NEARAI_MAX_FORWARDS=2
# Local testing only: the relay gate compares the body with this sha256 instead
# of the token's open meeting. Ignored on Vercel and in production builds.
# CHAIR_NEARAI_TEST_REQUEST_SHA256=

# Testing: dry-run the two write flows (off by default). With 1, POST
# /api/relay/petition and POST /api/convene validate the request and answer
# with a realistic response marked "dry_run": true, worked out from read-only
# views. Nothing is signed or sent: the petition queue and the meeting count
# are left as they are. Never set it in production.
# CHAIR_RELAY_DRY_RUN=0
